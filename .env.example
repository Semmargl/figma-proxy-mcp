# Copy to .env and fill in. .env is git-ignored: never commit your real token.
# Prefer passing FIGMA_API_KEY through your MCP client's "env" block instead.
FIGMA_API_KEY=figd_your_token_here

# Optional (see README "Environment variables" and SECURITY.md)
# FIGMA_PROXY_CACHE_DIR=/path/for/registry-and-diff-images
# FIGMA_PROXY_SVG_DIR=./exported-svgs
# FIGMA_PROXY_CHROME_PATH=/path/to/chrome
# FIGMA_PROXY_PORT=4444
