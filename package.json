{
  "name": "figma-proxy-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.Semmargl/figma-proxy-mcp",
  "description": "Read-only MCP server for Figma to code: normalised IR, Tailwind theme, PNG renders and visual diff (verify_render).",
  "keywords": [
    "mcp",
    "mcp-server",
    "figma",
    "model-context-protocol",
    "figma-to-code",
    "tailwind",
    "visual-regression",
    "claude",
    "cursor"
  ],
  "homepage": "https://github.com/Semmargl/figma-proxy-mcp#readme",
  "bugs": {
    "url": "https://github.com/Semmargl/figma-proxy-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Semmargl/figma-proxy-mcp.git"
  },
  "license": "MIT",
  "main": "proxy-mcp.js",
  "bin": {
    "figma-proxy-mcp": "proxy-mcp.js",
    "figma-proxy-mcp-doctor": "scripts/check-setup.js"
  },
  "files": [
    "proxy-mcp.js",
    "src/",
    "scripts/check-setup.js",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node proxy-mcp.js --stdio",
    "http": "node proxy-mcp.js",
    "check": "node proxy-mcp.js --check",
    "test": "node test/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.44.0",
    "pngjs": "^7.0.0"
  }
}
